# Copy this file to .env and fill in your values.
# .env is never committed to version control.

# ── Email (shared by all jobs via email_notifier.py) ──────────────────────────
# Gmail: generate an App Password at https://myaccount.google.com/apppasswords
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=you@gmail.com
NOTIFY_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_FROM_ADDR=you@gmail.com
NOTIFY_DEFAULT_TO=you@gmail.com

# ── Royal Caribbean (watch_for_royal_price_changes_xls) ───────────────────────
RCCL_USERNAME=you@gmail.com
RCCL_PASSWORD=your_rccl_password
RCCL_VDS_ID=your-vds-uuid
